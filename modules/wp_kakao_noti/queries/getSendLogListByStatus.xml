<query id="getSendLogListByStatus" action="select">
	<tables>
		<table name="wp_kakao_noti_log" alias="log" />
	</tables>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="status" var="filter_status" notnull="notnull" pipe="AND" />
	</conditions>
	<navigation>
		<index var="sort_index" default="log.log_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

<query id="getWishlist" action="select">
	<tables>
		<table name="poomahhi_wishlist" alias="w" />
		<table name="poomahhi_product" alias="p" type="left join">
			<conditions>
				<condition operation="equal" column="w.product_srl" default="p.product_srl" />
			</conditions>
		</table>
	</tables>
	<columns>
		<column name="w.*" />
	</columns>
	<conditions>
		<condition operation="equal" column="w.member_srl" var="member_srl" notnull="notnull" />
		<condition operation="equal" column="p.product_type" var="wishlist_type" pipe="AND" />
	</conditions>
	<navigation>
		<index var="sort_index" default="w.wishlist_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

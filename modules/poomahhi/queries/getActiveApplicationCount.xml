<query id="getActiveApplicationCount" action="select">
	<tables>
		<table name="poomahhi_application" alias="a" />
	</tables>
	<columns>
		<column name="count(*)" alias="count" />
	</columns>
	<conditions>
		<condition operation="equal" column="a.product_srl" var="product_srl" pipe="AND" />
		<condition operation="equal" column="a.member_srl" var="member_srl" pipe="AND" />
		<condition operation="notequal" column="a.status" var="exclude_status_1" default="cancelled" pipe="AND" />
		<condition operation="notequal" column="a.status" var="exclude_status_2" default="rejected" pipe="AND" />
	</conditions>
</query>

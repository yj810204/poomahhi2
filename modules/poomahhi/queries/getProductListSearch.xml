<query id="getProductListSearch" action="select">
	<tables>
		<table name="poomahhi_product" alias="p" />
		<table name="poomahhi_region" alias="r" type="left join">
			<conditions>
				<condition operation="equal" column="p.region_srl" default="r.region_srl" />
				<condition operation="equal" column="p.module_srl" default="r.module_srl" pipe="AND" />
			</conditions>
		</table>
	</tables>
	<columns>
		<column name="p.*" />
	</columns>
	<conditions>
		<condition operation="in" column="p.module_srl" var="module_srl_list" pipe="AND" />
		<condition operation="equal" column="p.category_srl" var="category_srl" pipe="AND" />
		<condition operation="equal" column="p.status" var="status" pipe="AND" />
		<condition operation="equal" column="p.product_type" var="product_type" pipe="AND" />
		<group pipe="AND">
			<condition operation="like" column="p.title" var="search_keyword" />
			<condition operation="like" column="p.company_name" var="search_keyword" pipe="or" />
			<condition operation="like" column="r.title" var="search_keyword" pipe="or" />
		</group>
	</conditions>
	<navigation>
		<index var="sort_index" default="product_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

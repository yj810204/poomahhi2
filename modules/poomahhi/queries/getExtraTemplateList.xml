<query id="getExtraTemplateList" action="select">
	<tables>
		<table name="poomahhi_extra_template" alias="et" />
	</tables>
	<columns>
		<column name="et.*" />
	</columns>
	<conditions>
		<condition operation="equal" column="et.module_srl" var="module_srl" pipe="AND" />
	</conditions>
	<navigation>
		<index var="sort_index" default="list_order" order="asc" />
		<list_count var="list_count" default="100" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

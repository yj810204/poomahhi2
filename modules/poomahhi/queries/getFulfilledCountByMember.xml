<query id="getFulfilledCountByMember" action="select">
	<tables>
		<table name="poomahhi_review" alias="r" />
	</tables>
	<columns>
		<column name="COUNT(r.review_srl)" alias="fulfilled_count" />
	</columns>
	<conditions>
		<condition operation="equal" column="r.member_srl" var="member_srl" notnull="notnull" />
	</conditions>
</query>

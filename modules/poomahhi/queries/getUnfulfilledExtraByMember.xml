<query id="getUnfulfilledExtraByMember" action="select">
	<tables>
		<table name="poomahhi_member_fulfillment_extra" alias="e" />
	</tables>
	<columns>
		<column name="e.unfulfilled_count" />
	</columns>
	<conditions>
		<condition operation="equal" column="e.member_srl" var="member_srl" notnull="notnull" />
	</conditions>
</query>

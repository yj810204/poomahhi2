<query id="getActiveApplicationByProductAndMember" action="select">
	<tables>
		<table name="poomahhi_application" alias="a" />
	</tables>
	<columns>
		<column name="a.*" />
	</columns>
	<conditions>
		<condition operation="equal" column="a.product_srl" var="product_srl" pipe="AND" />
		<condition operation="equal" column="a.member_srl" var="member_srl" pipe="AND" />
		<condition operation="notequal" column="a.status" var="exclude_1" default="cancelled" pipe="AND" />
		<condition operation="notequal" column="a.status" var="exclude_2" default="rejected" pipe="AND" />
	</conditions>
	<navigation>
		<index var="sort_index" default="application_srl" order="desc" />
		<list_count var="list_count" default="1" />
		<page_count var="page_count" default="1" />
		<page var="page" default="1" />
	</navigation>
</query>

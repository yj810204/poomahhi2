<query id="getPointLogList" action="select">
	<tables>
		<table name="poomahhi_point_log" alias="l" />
	</tables>
	<columns>
		<column name="l.*" />
	</columns>
	<conditions>
		<condition operation="equal" column="l.member_srl" var="member_srl" notnull="notnull" pipe="AND" />
		<condition operation="equal" column="l.type" var="type" pipe="AND" />
		<condition operation="more" column="l.regdate" var="start_date" pipe="AND" />
		<condition operation="less" column="l.regdate" var="end_date" pipe="AND" />
	</conditions>
	<navigation>
		<index var="sort_index" default="log_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

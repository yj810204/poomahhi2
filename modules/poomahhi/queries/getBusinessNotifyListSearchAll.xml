<query id="getBusinessNotifyListSearchAll" action="select">
	<tables>
		<table name="ncenterlite_notify" />
	</tables>
	<index_hint for="ALL">
		<index table="ncenterlite_notify" name="idx_member_srl_and_readed" type="USE" />
	</index_hint>
	<columns>
		<column name="*" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" var="member_srl" filter="number" notnull="notnull" pipe="AND" />
		<condition operation="equal" column="readed" var="readed" pipe="AND" />
		<group pipe="AND">
			<condition operation="like" column="target_body" var="search_keyword" />
			<condition operation="like" column="target_summary" var="search_keyword" pipe="or" />
		</group>
	</conditions>
	<navigation>
		<index default="regdate" var="list_order" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

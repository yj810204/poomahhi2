<query id="getMyWrittenMemberReviews" action="select">
	<tables>
		<table name="poomahhi_member_review" alias="mr" />
		<table name="poomahhi_application" alias="a" type="left join">
			<conditions>
				<condition operation="equal" column="mr.application_srl" default="a.application_srl" />
			</conditions>
		</table>
		<table name="poomahhi_product" alias="p" type="left join">
			<conditions>
				<condition operation="equal" column="mr.product_srl" default="p.product_srl" />
			</conditions>
		</table>
	</tables>
	<columns>
		<column name="mr.*" />
		<column name="a.applicant_name" />
		<column name="a.gender" />
		<column name="a.birth_date" />
		<column name="a.regdate" alias="apply_date" />
		<column name="p.title" alias="product_title" />
		<column name="p.company_name" />
		<column name="p.product_image" />
		<column name="p.product_type" />
		<column name="p.region_srl" />
	</columns>
	<conditions>
		<condition operation="equal" column="mr.reviewer_member_srl" var="reviewer_member_srl" notnull="notnull" />
	</conditions>
	<navigation>
		<index var="sort_index" default="mr.review_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

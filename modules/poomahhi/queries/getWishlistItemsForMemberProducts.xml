<query id="getWishlistItemsForMemberProducts" action="select">
	<tables>
		<table name="poomahhi_wishlist" alias="w" />
	</tables>
	<columns>
		<column name="w.product_srl" />
	</columns>
	<conditions>
		<condition operation="equal" column="w.member_srl" var="member_srl" notnull="notnull" pipe="AND" />
		<condition operation="in" column="w.product_srl" var="product_srl_list" notnull="notnull" pipe="AND" />
	</conditions>
</query>

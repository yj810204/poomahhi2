<query id="getApplication" action="select">
	<tables>
		<table name="poomahhi_application" alias="a" />
	</tables>
	<columns>
		<column name="a.*" />
	</columns>
	<conditions>
		<condition operation="equal" column="a.application_srl" var="application_srl" notnull="notnull" />
	</conditions>
</query>

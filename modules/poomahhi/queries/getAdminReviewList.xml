<query id="getAdminReviewList" action="select">
	<tables>
		<table name="poomahhi_review" alias="r" />
		<table name="poomahhi_product" alias="p" type="left join">
			<conditions>
				<condition operation="equal" column="r.product_srl" default="p.product_srl" />
			</conditions>
		</table>
	</tables>
	<columns>
		<column name="r.*" />
		<column name="p.member_srl" alias="product_owner_srl" />
		<column name="p.title" alias="product_title" />
		<column name="p.company_name" />
		<column name="p.product_image" />
	</columns>
	<conditions>
		<condition operation="equal" column="r.application_srl" var="application_srl" />
		<condition operation="equal" column="r.product_srl" var="product_srl" />
		<condition operation="like" column="r.content" var="keyword" pipe="OR" />
	</conditions>
	<navigation>
		<index var="sort_index" default="r.review_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

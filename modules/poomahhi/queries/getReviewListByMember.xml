<query id="getReviewListByMember" action="select">
	<tables>
		<table name="poomahhi_review" alias="r" />
	</tables>
	<columns>
		<column name="r.*" />
	</columns>
	<conditions>
		<condition operation="equal" column="r.member_srl" var="member_srl" notnull="notnull" />
	</conditions>
	<navigation>
		<index var="sort_index" default="review_srl" order="desc" />
		<list_count var="list_count" default="20" />
		<page_count var="page_count" default="10" />
		<page var="page" default="1" />
	</navigation>
</query>

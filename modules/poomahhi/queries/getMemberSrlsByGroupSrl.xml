<query id="getMemberSrlsByGroupSrl" action="select">
	<tables>
		<table name="member_group_member" />
	</tables>
	<columns>
		<column name="member_srl" />
	</columns>
	<conditions>
		<condition operation="equal" column="group_srl" var="group_srl" filter="number" notnull="notnull" pipe="AND" />
	</conditions>
	<navigation>
		<index var="list_order" default="member_srl" order="asc" />
		<list_count var="list_count" default="50000" />
		<page_count var="page_count" default="5" />
		<page var="page" default="1" />
	</navigation>
</query>

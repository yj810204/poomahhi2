<query id="getProductList" action="select">
	<tables>
		<table name="poomahhi_product" alias="p" />
	</tables>
	<columns>
		<column name="p.*" />
	</columns>
	<conditions>
		<condition operation="equal" column="p.module_srl" var="module_srl" pipe="AND" />
		<condition operation="equal" column="p.product_type" var="product_type" pipe="AND" />
		<condition operation="equal" column="p.region_srl" var="region_srl" pipe="AND" />
		<condition operation="equal" column="p.status" var="status" pipe="AND" />
	</conditions>
	<navigation>
		<index var="sort_index" default="product_srl" order="desc" />
		<list_count var="list_count" default="6" />
		<page_count var="page_count" default="1" />
		<page var="page" default="1" />
	</navigation>
</query>
